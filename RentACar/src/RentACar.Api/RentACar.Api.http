@RentACar_HostAddress = http://localhost:5288

### TESTE 1 - Registar utilizador

POST {{RentACar_HostAddress}}/api/auth/register
Content-Type: application/json

{
    "name": "Pedro",
    "email": "pedro@teste.com",
    "password": "Teste123"
}

### TESTE 2 - Login

POST {{RentACar_HostAddress}}/api/auth/login
Content-Type: application/json

{
    "email": "pedro@teste.com",
    "password": "Teste123"
}

